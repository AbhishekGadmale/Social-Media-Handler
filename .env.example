DATABASE_URL="postgresql://postgres:password@localhost:5432/agency_os?schema=public"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/agency_os_test?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Express Trust Proxy Configuration
# - local/direct development: unset or false
# - standard single-ingress production: 1
# - multi-hop proxy chains: exact hop count
# - If a CDN such as Cloudflare is added in front of the ingress, increase the configured hop count accordingly (for example, from 1 to 2).
# - DANGER: `TRUST_PROXY=true` trusts all `X-Forwarded-For` entries. Only use behind a proxy that strips/overwrites incoming forwarded headers. Never use on a publicly reachable API.
# TRUST_PROXY=1

# OAuth Secrets
YOUTUBE_CLIENT_ID="mock-client-id"
YOUTUBE_CLIENT_SECRET="mock-client-secret"

# Object Storage Configuration
OBJECT_STORAGE_ENDPOINT="http://127.0.0.1:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET="agency-os-media"
OBJECT_STORAGE_ACCESS_KEY_ID="minioadmin"
OBJECT_STORAGE_SECRET_ACCESS_KEY="minioadmin"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"
MEDIA_UPLOAD_URL_TTL_SECONDS="900"
MEDIA_MAX_UPLOAD_BYTES="524288000"