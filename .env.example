DATABASE_URL="postgresql://postgres:password@localhost:5432/agency_os?schema=public"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/agency_os_test?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Frontend application URL (used for CORS and OAuth redirect destinations)
# Defaults to http://localhost:3000 if not specified.
FRONTEND_URL="http://localhost:3000"

# 32-byte hexadecimal string (64 hex characters) used for AES-256-GCM credential encryption.
# Generate via: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Public backend URL used for OAuth callbacks and external integrations.
# Production: REQUIRED and must use HTTPS (except for local loopback hosts: localhost, 127.0.0.1, [::1]).
# Development: optional; defaults to http://localhost:3001.
# API_PUBLIC_URL=http://localhost:3001

# Express Trust Proxy Configuration
# - local/direct development: unset or false
# - standard single-ingress production (direct TLS on NGINX): 1
# - multi-hop proxy chains (e.g. Cloudflare Tunnel -> NGINX Ingress -> API): 2
# - DANGER: `TRUST_PROXY=true` trusts all `X-Forwarded-For` entries. Only use behind a proxy that strips/overwrites incoming forwarded headers. Never use on a publicly reachable API.
# - IMPORTANT: Do not set TRUST_PROXY higher than the actual number of trusted proxy hops.
#   Setting it higher allows direct attackers to spoof their client IP address via X-Forwarded-For!
# TRUST_PROXY=2

# Staging Deployment & Unified Ingress Configuration
# - STAGING_BIND_IP: Host IP interface bound by the NGINX ingress service (default 127.0.0.1).
#   For Cloudflare Tunnel (cloudflared), bind to 127.0.0.1 to guarantee ZERO inbound ports are exposed to the public internet.
#   Set to 0.0.0.0 only if terminating direct TLS on the host with an external origin firewall.
STAGING_BIND_IP=127.0.0.1
# - STAGING_PORT: Host port bound by the NGINX ingress service (default 80).
STAGING_PORT=80

# Production / Staging Application Secrets
# When using docker-compose.staging.yml, these variables must be explicitly set without development fallbacks.
# Generate strong random strings via: openssl rand -hex 32
# Genuinely required staging database credentials
POSTGRES_PASSWORD="replace-with-secure-postgres-password"

# Test-only override for unencrypted HTTP authentication in staging/smoke-tests.
# DANGER: Must remain unset or false in production. If set to true, authentication cookies are
# issued without the Secure flag over unencrypted HTTP for testing purposes.
# ALLOW_INSECURE_HTTP_AUTH=false

# OAuth Secrets
YOUTUBE_CLIENT_ID="mock-client-id"
YOUTUBE_CLIENT_SECRET="mock-client-secret"
LINKEDIN_CLIENT_ID="mock-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="mock-linkedin-client-secret"

# Object Storage Configuration
# Local MinIO Development defaults:
OBJECT_STORAGE_ENDPOINT="http://127.0.0.1:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET="agency-os-media"
OBJECT_STORAGE_ACCESS_KEY_ID="minioadmin"
OBJECT_STORAGE_SECRET_ACCESS_KEY="minioadmin"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"
MEDIA_UPLOAD_URL_TTL_SECONDS="900"
MEDIA_MAX_UPLOAD_BYTES="524288000"

# Public Object Storage Endpoint (REQUIRED for Staging/Production):
# Must be an explicit, browser-reachable HTTPS URL used by client browsers for presigned PUT/GET requests.
# Internal Docker hostnames (e.g. http://minio:9000) are strictly rejected in production.
# Examples:
# - Cloudflare R2: OBJECT_STORAGE_PUBLIC_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# - AWS S3: OBJECT_STORAGE_PUBLIC_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# OBJECT_STORAGE_PUBLIC_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# Required Bucket CORS Configuration for Cloudflare R2 / AWS S3:
# Apply this CORS policy to the storage bucket so browsers can upload via presigned URLs:
# [
#   {
#     "AllowedOrigins": ["https://staging.agency-os.com"],
#     "AllowedMethods": ["PUT", "GET", "HEAD"],
#     "AllowedHeaders": ["*"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3600
#   }
# ]
