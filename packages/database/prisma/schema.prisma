datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceRole {
  OWNER
  MANAGER
  EDITOR
  CLIENT_APPROVER
  VIEWER
}

enum SocialProvider {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER
  TIKTOK
  YOUTUBE
}

enum SocialAccountStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISCONNECTED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PUBLISHING
  PARTIAL
  PUBLISHED
  FAILED
  UNKNOWN
  DELETING
  DELETED
}

enum FailureCategory {
  TRANSIENT
  RATE_LIMITED
  AUTH_REQUIRED
  VALIDATION
  PERMANENT
  UNKNOWN_RESULT
}

enum SyncRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model User {
  id             String            @id @db.Uuid
  email          String            @unique
  hashedPassword String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  memberships    WorkspaceMember[]
  posts          Post[]            @relation("PostAuthor")
}

model Organization {
  id         String      @id @db.Uuid
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workspaces Workspace[]
}

model Workspace {
  id             String       @id @db.Uuid
  name           String
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members              WorkspaceMember[]
  socialAccounts       SocialAccount[]
  posts                Post[]
  postPlatformVariants PostPlatformVariant[]
  auditLogs            AuditLog[]
  mediaAssets          MediaAsset[]

  @@index([organizationId])
}

model WorkspaceMember {
  id          String        @id @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model SocialAccount {
  id           String              @id @db.Uuid
  workspaceId  String              @db.Uuid
  provider     SocialProvider
  externalId   String
  name         String?
  capabilities String[]
  status       SocialAccountStatus
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection SocialConnection?
  variants   PostPlatformVariant[]
  metrics    AccountMetricDaily[]

  @@unique([provider, externalId])
  @@index([workspaceId, provider])
}

model SocialConnection {
  id              String @id @db.Uuid
  socialAccountId String @unique @db.Uuid

  encryptedAccessToken String
  accessTokenIv        String
  accessTokenAuthTag   String

  encryptedRefreshToken String?
  refreshTokenIv        String?
  refreshTokenAuthTag   String?

  keyVersion       Int       @default(1)
  expiresAt        DateTime?
  refreshExpiresAt DateTime?
  grantedScopes    String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model Post {
  id          String     @id @db.Uuid
  workspaceId String     @db.Uuid
  authorId    String?    @db.Uuid
  content     String
  status      PostStatus
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?                 @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  variants  PostPlatformVariant[]
  media     PostMedia[]

  @@index([workspaceId])
}

model PostPlatformVariant {
  id              String     @id @db.Uuid
  postId          String     @db.Uuid
  socialAccountId String     @db.Uuid
  workspaceId     String     @db.Uuid
  status          PostStatus
  externalPostId  String?
  canonicalUrl    String?
  content         String?
  providerOptions Json?

  dispatchVersion         Int       @default(0)
  providerProcessingState String?

  scheduledAt         DateTime?
  queuedAt            DateTime?
  publishingStartedAt DateTime?
  publishedAt         DateTime?
  cancelledAt         DateTime?

  reconciledAt        DateTime?
  reconciledBy        String?
  reconciliationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post          Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount        @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attempts      PublicationAttempt[]

  @@unique([postId, socialAccountId])
  @@index([postId])
  @@index([socialAccountId])
  @@index([workspaceId])
  @@index([status, scheduledAt])
}

model PublicationAttempt {
  id               String           @id @db.Uuid
  variantId        String           @db.Uuid
  attemptNumber    Int
  status           String
  failureCategory  FailureCategory?
  failureCode      String?
  providerResponse Json?
  executionHeartbeatAt DateTime?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  variant PostPlatformVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, attemptNumber])
  @@index([variantId])
}

enum MediaAssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model MediaAsset {
  id          String           @id @db.Uuid
  workspaceId String           @db.Uuid
  filename    String
  mimeType    String
  byteSize    Int
  storageKey  String
  status      MediaAssetStatus
  processingStartedAt DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     PostMedia[]

  @@index([workspaceId])
}

model PostMedia {
  id        String @id @db.Uuid
  postId    String @db.Uuid
  mediaId   String @db.Uuid
  sortOrder Int    @default(0)

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@index([postId])
  @@index([mediaId])
}

model AccountMetricDaily {
  id              String   @id @db.Uuid
  socialAccountId String   @db.Uuid
  date            DateTime @db.Date
  followers       Int      @default(0)
  engagement      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, date])
}

model WebhookEvent {
  id        String   @id @db.Uuid
  eventId   String?  @unique
  provider  String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SyncRun {
  id        String        @id @db.Uuid
  status    SyncRunStatus
  counts    Json?
  error     String?
  startedAt DateTime      @default(now())
  endedAt   DateTime?
}

model AuditLog {
  id          String   @id @db.Uuid
  workspaceId String?  @db.Uuid
  actorId     String?  @db.Uuid
  action      String
  targetType  String
  targetId    String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
